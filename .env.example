# Supabase Configuration (P0 Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe Configuration (P0 Required)
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Printify Configuration (P0 Required)
PRINTIFY_API_TOKEN=your_printify_api_token
PRINTIFY_SHOP_ID=your_printify_shop_id
# Safety overrides for Printify order submissions (set to false for safety in live)
PRINTIFY_AUTO_SUBMIT_LIVE_ORDERS=false
PRINTIFY_CREATE_DRAFT_IN_LIVE_MODE=false
PRINTIFY_WEBHOOK_SECRET=your_printify_webhook_secret

# Cloudinary Configuration (P0 Required)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=printme_designs

# App Configuration (P0 Required)
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAILS=admin@printme.ai

# AI Provider Configuration (Optional, defaults to mock if not configured)
AI_PROVIDER=mock
OPENAI_API_KEY=sk-proj-your_openai_key
