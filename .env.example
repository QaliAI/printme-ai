# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
NEXT_PUBLIC_COMMERCE_V2_ENABLED=false
NEXT_PUBLIC_HOMEPAGE_V2_ENABLED=false
NEXT_PUBLIC_UNIFIED_CREATE_ENABLED=false

# Server-only Supabase, Stripe, Printify, Cloudinary, and AI configuration
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
COMMERCE_PERSISTENCE_ENABLED=false
COMMERCE_DESIGNS_DATABASE_ENABLED=false
COMMERCE_CATALOG_SYNC_SECRET=generate-a-high-entropy-server-only-secret
COMMERCE_CHECKOUT_ENABLED=false
PRINTIFY_FULFILLMENT_MODE=disabled
COMMERCE_OPERATIONS_SECRET=generate-a-separate-high-entropy-secret
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
PRINTIFY_API_TOKEN=your-printify-api-token
PRINTIFY_SHOP_ID=your-printify-shop-id
PRINTIFY_USER_AGENT=PrintMe.ai/1.0
# Shared secret configured on each Printify webhook subscription (HMAC-SHA256)
PRINTIFY_WEBHOOK_SECRET=generate-a-high-entropy-printify-webhook-secret
PRINTIFY_LIVE_SMOKE_TEST=false
PRINTIFY_AUTO_CLEANUP=false
PRINTIFY_AUTO_SUBMIT_LIVE_ORDERS=false
PRINTIFY_CREATE_DRAFT_IN_LIVE_MODE=false
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=printme_designs
ADMIN_EMAILS=admin@printme.ai
AI_PROVIDER=mock
OPENAI_API_KEY=sk-proj-your_openai_key
